          "raw": "{\n    \"sourceType\": \"Warehouse\", // required, enum: [\"GRN\", \"Warehouse\"]\n    \"sourceWarehouseId\": \"69723108fccaa9791e7f573a\", // required for Warehouse → Storefront transfers, must be valid ObjectId\n    \"destinationStorefrontId\": \"6972323c302fd1e227232c5f\", // required for Warehouse → Storefront transfers, must be valid ObjectId\n    \"lineItems\": [\n        {\n            \"productCode\": \"COKE1.5L\", // required, must exist in Inventory and have stock in source warehouse\n            \"quantity\": 50, // required, must be positive number, cannot exceed available warehouse stock\n            \"notes\": \"Restocking storefront\" // optional, maxlength: 500\n        }\n    ],\n    \"transferDate\": \"2025-12-15\", // optional, default: current date, ISO date format\n    \"notes\": \"Weekly restocking for downtown storefront\" // optional, maxlength: 1000\n}",
          "options": {
