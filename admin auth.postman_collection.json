    {
      "name": "login",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "// Parse the JSON response",
              "const response = pm.response.json();",
              "",
              "// Extract the token from the response (it's inside response.data.token)",
              "const token = response.data.token;",
              "",
              "// Log the token to the console for debugging",
              "console.log(\"Extracted Token:\", token);",
              "",
              "// Check if the token exists in the response",
              "if (token) {",
              "    // Save or update the JWT token in the environment variable",
              "    pm.environment.set(\"jwt\", token);",
              "    console.log(\"JWT token saved/updated in environment variable: jwt\");",
              "} else {",
              "    console.error(\"Token not found in the response\");",
              "}",
              "",
              "// Optional: Verify that the token has been saved correctly",
              "const savedToken = pm.environment.get(\"jwt\");",
              "if (savedToken) {",
              "    console.log(\"Verified saved JWT token:\", savedToken);",
              "} else {",
              "    console.error(\"Failed to save JWT token in environment\");",
              "}",
              "",
              "// Test to ensure the request was successful (e.g., status 200)",
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "// Optional: Test if the response includes a token",
              "pm.test(\"Response contains a token\", function () {",
              "    pm.expect(response).to.have.property(\"data\");",
              "    pm.expect(response.data).to.have.property(\"token\");",
              "    pm.expect(response.data.token).to.be.a(\"string\").and.not.empty;",
              "});"
            ],
            "type": "text/javascript",
            "packages": {}
          }
        }
      ],
